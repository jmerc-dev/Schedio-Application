<Window x:Class="Schedio_Application.MVVM.View.Windows.MBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:Schedio_Application.MVVM.ViewModel.Converters"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Schedio_Application.MVVM.View.Windows"
        mc:Ignorable="d"
        Title="" MinHeight="150" MinWidth="300"
        Height="auto" Width="auto"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <converters:MBoxTypeToVisibilityConverter x:Key="mboxTypeToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="10,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Stretch="Uniform"
                   Source="pack://application:,,,/Schedio Application;component/Resources/Images/info.png"
                   Margin="5"
                   Name="img_Picture"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock MaxWidth="300"
                    TextWrapping="WrapWithOverflow"
                    HorizontalAlignment="Left"
                    Visibility="Visible"
                    VerticalAlignment="Center"
                    Margin="5"
                    Name="tb_Message">
                </TextBlock>
                <Grid x:Name="container_TbxConfirm" Visibility="{Binding Type, Converter={StaticResource mboxTypeToVisibilityConverter}}">
                    <TextBox x:Name="tbx_Confirm"
                         Grid.Column="1"
                         Height="20"
                         Width="120"
                         Visibility="Visible"
                         TextChanged="tbx_Confirm_TextChanged"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="5"
                         Padding="2"/>
                    <TextBlock IsHitTestVisible="False" Text="Type here" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" Foreground="DarkGray">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=tbx_Confirm}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                
            </StackPanel>
            
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource CancelButton}"
                    Content="Cancel"
                    Name="btn_Cancel"
                    Visibility="Collapsed"
                    Height="30"
                    Width="100"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    Margin="5,0"/>
            <Button Style="{StaticResource ConfirmButton}"
                    Content="OK"
                    Height="30"
                    Width="100"
                    HorizontalAlignment="Right"
                    Name="btn_OK"
                    IsDefault="True"
                    Click="btn_OK_Click"/>
            <Button Style="{StaticResource DeleteButton}"
                    Content="OK"
                    Height="30"
                    Width="100"
                    Visibility="{Binding Type, Converter={StaticResource mboxTypeToVisibilityConverter}}"
                    HorizontalAlignment="Right"
                    Name="btn_OKRed"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="btn_OK_Click"/>
        </StackPanel>
        
    </Grid>
</Window>
