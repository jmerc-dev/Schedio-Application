<Window x:Class="Schedio_Application.MVVM.View.Windows.BulkClear"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Schedio_Application.MVVM.View.Windows"
        mc:Ignorable="d"
        Title="BulkClear" Height="550" Width="470"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Border BorderBrush="{StaticResource GreyColor}" BorderThickness="1" Background="{StaticResource PrimaryBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="Grid_MouseLeftButtonDown" Background="Transparent">
                <Button HorizontalAlignment="Right" Height="25" Width="25" Style="{StaticResource ImageButton}" Margin="5, 0" IsCancel="True">
                    <Image Source="pack://application:,,,/Schedio Application;component/Resources/Images/close.png"/>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="20,5,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Bulk Clear" Style="{StaticResource TitleText}" FontSize="27" Grid.Row="0"/>
                <StackPanel Orientation="Horizontal" Grid.Row="1">
                    <Grid Grid.Row="0" Margin="0,10" Height="30">
                        <TextBox Width="200" FontSize="15" VerticalContentAlignment="Center" TextBlock.TextAlignment="Left" Name="tb_SearchSubject" Padding="5,0,30,0"/>

                        <TextBlock IsHitTestVisible="False" Text="Search Name" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" Foreground="DarkGray" FontSize="15">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=tb_SearchSubject}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Image IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5">
                            <Image.Style>
                                <Style TargetType="{x:Type Image}">
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                    <Setter Property="Source" Value="pack://application:,,,/Schedio Application;component/Resources/Images/find-not-active.png"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFocused, ElementName=tb_SearchSubject}" Value="True">
                                            <Setter Property="Source" Value="pack://application:,,,/Schedio Application;component/Resources/Images/find-active.png"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Grid>
                    <TextBlock Text="Category:" Style="{StaticResource UneditableText}" Margin="30,10,0,10" VerticalAlignment="Center"/>
                    <ComboBox Style="{StaticResource MainComboBox}" Name="cbox_Category" SelectionChanged="ComboBox_SelectionChanged" Width="120" Height="30" VerticalContentAlignment="Center" Margin="10,0,0,0">
                        <ComboBoxItem Content="ClassSection"/>
                        <ComboBoxItem Content="Person"/>
                        <ComboBoxItem Content="Room"/>
                        <ComboBoxItem Content="Day"/>
                    </ComboBox>
                </StackPanel>

                <ListView ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="lv_CategorizedList" Grid.Row="2" ItemContainerStyle="{StaticResource lvi_Simple}" Template="{StaticResource template_Simple}">
                    <ListView.Style>
                        <Style TargetType="{x:Type ListView}"/>
                    </ListView.Style>
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="Group Name" Width="200">
                                <GridViewColumn.CellTemplate >
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Entry Count" Width="240">
                                <GridViewColumn.CellTemplate >
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Count}" TextAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                
                <Grid Grid.Row="3">
                    <Button Height="35" Width="120" VerticalAlignment="Center" HorizontalAlignment="Right" Content="Clear Selected" Style="{StaticResource ConfirmButton}"/>
                    <Button Height="35" Width="90" VerticalAlignment="Center" HorizontalAlignment="Left" Content="Clear All" Style="{StaticResource DeleteButton}"/>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>
